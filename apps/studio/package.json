{
  "name": "@newledge/studio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "test": "vitest run --coverage",
    "preview": "vite preview",
    "clean": "rm -rf dist .turbo *.tsbuildinfo coverage"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@newledge/board": "workspace:*",
    "@newledge/board-layout": "workspace:*",
    "@newledge/view-generator-handout": "workspace:*",
    "@xyflow/react": "^12.11.3",
    "elkjs": "^0.12.0",
    "marked": "^18.0.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/dagre": "^0.7.54",
    "@types/node": "^26.4.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^7.0.0"
  }
}
