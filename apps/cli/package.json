{
  "name": "@newledge/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "newledge": "./dist/index.js"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --coverage",
    "start": "node ./dist/index.js",
    "clean": "rm -rf dist .turbo *.tsbuildinfo coverage"
  },
  "dependencies": {
    "@braidhq/core": "^0.2.1",
    "@braidhq/schema": "^0.2.1",
    "@newledge/ontology-knowledge": "workspace:*",
    "@newledge/source-loader-web": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0"
  }
}
